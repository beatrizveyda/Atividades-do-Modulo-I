# 8. Crie uma função que receba um número e retorne True se ele for par e False caso contrário.
def par(numero):
    return numero % 2 == 0

print(par(10))

# 9. Crie uma função que receba uma lista de números e retorne a média deles.
def media(lista):
    return sum(lista) / len(lista)

numeros = [10, 6, 9, 8]
print(media(numeros))

